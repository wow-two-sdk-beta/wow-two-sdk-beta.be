<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DATA TESTS (beta-forever exception, like Mediator.Tests / Migrations.Tests / Messaging.Tests).

    The data-pipeline vector's P0 floor: interceptor wiring under the flagship AddPostgresPersistence registration,
    the process-global Dapper casing latch, the RelationalTestDb harness self-test, and the four load-bearing
    architecture probes promoted to permanent tests (savepoint events + synthetic-frame fallback, DbContextPool
    Tracked-subscription survival, outbox/session transaction collision).

    Testcontainers Postgres — the provider is pinned by each fixture instance: SQLite has no
    xmin, no FOR UPDATE and different savepoint semantics, so a green SQLite run here would manufacture confidence.
    References the core mono-lib and matches its FrameworkReference so Microsoft.Extensions.* resolve from the
    shared framework rather than CPM-pinned packages.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Test-code conventions clash with latest-recommended-as-error: underscores in test names (CA1707),
         no ConfigureAwait (CA2007), public-method null guards (CA1062), static-test-class (CA1052),
         public fixture/collection types (CA1515), xUnit1041 (fixture ctor injection). -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CA1707;CA2007;CA1062;CA1052;CA1819;CA1515;xUnit1041</WarningsNotAsErrors>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Match the mono-lib's FrameworkReference so Microsoft.Extensions.* resolve from the shared framework. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Azurite" />
    <PackageReference Include="Dapper" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../WoW.Two.Sdk.Backend.Beta.csproj" />
    <!-- The harness under test as well as used by it: RelationalTestDb + the DI-built-context seam. -->
    <ProjectReference Include="../Testing.Data/WoW.Two.Sdk.Backend.Beta.Testing.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
