<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WEB-FREE MIGRATOR CLI: the `wow-migrate` dotnet tool.

    Lives OUTSIDE the mono-lib on purpose. The mono-lib (WoW.Two.Sdk.Beta.Be.csproj) carries a
    FrameworkReference to Microsoft.AspNetCore.App, so referencing it would drag ASP.NET into a console
    tool. Instead this project:
      * references ONLY the BCL-only Data.Abstractions (IDbConnectionFactory + DataSourceConnectionFactory,
        namespace WoW.Two.Sdk.Beta.Be.Data.Dapper) and the BCL-only kernel Abstractions (Result + AppError),
      * LINK-compiles the SQL migrator engine sources from ../../Migrations/Bespoke/ (no mono-lib reference),
      * brings its own concrete DI container + logging + Npgsql + Dapper via PackageReferences.

    NO FrameworkReference. NO mono-lib ProjectReference. Verified web-free via the transitive package
    listing (no Microsoft.AspNetCore.* / MediatR).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>WoW.Two.Sdk.Beta.Be.Data.Migrations.Cli</RootNamespace>
    <AssemblyName>wow-migrate</AssemblyName>
  </PropertyGroup>

  <!-- Real dotnet tool: installs as `wow-migrate` via `dotnet tool install`. -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>wow-migrate</ToolCommandName>
    <PackageId>WoW2.Sdk.Beta.Be.Data.Migrations.Cli</PackageId>
    <CreateRidSpecificToolPackages>false</CreateRidSpecificToolPackages>
    <Description>Web-free SQL migrator CLI (`wow-migrate`) over the WoW Two be sdk bespoke migrator — the image's migrate verb tree (check, plan, apply, seed, sets, rollback, forget, repair, baseline, claim, locks, unlock) plus new and promote, against a Postgres database, for one migration set or every set in a --sets manifest.</Description>
    <PackageTags>wow-two; backend; beta; sdk; data; migrations; cli; dotnet-tool; postgres</PackageTags>
    <!-- README packaging from Directory.Build.props is conditional on a sibling README; none here, so disable the pack hint. -->
    <PackageReadmeFile></PackageReadmeFile>
  </PropertyGroup>

  <!-- The one web-free seam: IDbConnectionFactory + DataSourceConnectionFactory (BCL-only). -->
  <ItemGroup>
    <ProjectReference Include="../../Abstractions/WoW.Two.Sdk.Beta.Be.Data.Abstractions.csproj" />
    <!-- The migrator returns Result<T> for its domain failures (N81); the carrier and its AppError live in the BCL-only kernel. -->
    <ProjectReference Include="../../../Abstractions/WoW.Two.Sdk.Beta.Be.Abstractions.csproj" />
  </ItemGroup>

  <!-- Link (do NOT reference) the SQL migrator engine — compiles it web-free into this tool. -->
  <ItemGroup>
    <Compile Include="../../Migrations/Bespoke/**/*.cs" />
    <!-- The migrate verb tree an image answers as `app migrate <verb>`: one tree, compiled into the tool as well. -->
    <Compile Include="../../Migrations/Commands/**/*.cs" />
    <Compile Include="../../../Foundation/Options/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Dapper" />
    <!-- DI host + logging: the engine references only the abstractions; the CLI brings the concrete container. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>

</Project>
