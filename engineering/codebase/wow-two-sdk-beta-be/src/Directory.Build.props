<Project>

  <!-- Shared MSBuild properties for every csproj under src/ -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Beta-forever: keep perf/style/design analyzer suggestions visible but non-blocking.
         Correctness analyzers stay as errors. -->
    <!-- CA1822 (mark member static) + CA1720 (identifier contains type name, e.g. EmojiSpec.Char): design/perf, not
         correctness. Renaming would churn the extracted Codes engine + its serialized StyleJson contract — keep non-blocking. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CA1848;CA1873;CA1305;CA1000;CA1716;CA1822;CA1720</WarningsNotAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Test projects run as Development so the container validates on build; Production hides a
       missing registration until something resolves it. -->

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)tests.runsettings</RunSettingsFilePath>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Packaging defaults — every csproj produces a NuGet unless the project explicitly opts out -->

  <PropertyGroup>
    <IsPackable Condition="'$(IsPackable)' == ''">true</IsPackable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>WoW Two</Authors>
    <Company>WoW Two</Company>
    <Copyright>Copyright © WoW Two</Copyright>
    <PackageProjectUrl>https://github.com/wow-two-sdk-beta/wow-two-sdk-beta.be</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wow-two-sdk-beta/wow-two-sdk-beta.be.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Versioning — bumped together by CI on push to main -->

  <PropertyGroup>
    <!-- Source of truth. CI (publish.yml) bumps Version + FileVersion and commits this back on each release. -->
    <Version>10.0.68-beta</Version>
    <AssemblyVersion>10.0.0.0</AssemblyVersion>
    <FileVersion>10.0.68</FileVersion>
  </PropertyGroup>

  <!-- README is the package's PackageReadmeFile when one sits next to the csproj (e.g. src/README.md for the mono-lib).
       This is a functional NuGet file, NOT a folder lead-doc — the no-README-below-root rule does not apply to it.
       Set PackageReadmeFile ONLY when the file exists, so README-less packable projects (Abstractions, CLI) don't fail NU5039. -->

  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
