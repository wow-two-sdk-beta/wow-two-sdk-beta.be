    <PackageVersion Include="Verify.Http" Version="6.4.0" />
    <!-- Transitive-pins (CentralPackageTransitivePinningEnabled) over test-only deps carrying critical advisories
         (NU1904) that block the audit-gated publish — patched, minimal bumps:
           · Scriban.Signed 5.5.0 → 7.2.5 (GHSA-5wr9-m6jw-xx44), pulled by Verify.*
           · System.Drawing.Common 5.0.0 → 6.0.0 (GHSA-rxg9-xrhp-64gj) — the version QRCoder already requires (≥6.0.0);
             the vulnerable 5.0.0 only surfaced in test projects without QRCoder, so unify everything on the patched 6.0.0.
           · Microsoft.OpenApi.Readers 1.2.3 → 1.6.30 (GHSA-7pxr-59rr-hqj2), pulled by WireMock.Net.OpenApiParser. -->
    <PackageVersion Include="Scriban.Signed" Version="7.2.5" />
    <PackageVersion Include="System.Drawing.Common" Version="6.0.0" />
    <PackageVersion Include="Microsoft.OpenApi.Readers" Version="1.6.30" />
    <PackageVersion Include="WireMock.Net" Version="1.6.10" />
    <PackageVersion Include="Testcontainers" Version="4.1.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.1.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.1.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.1.0" />
    <PackageVersion Include="Testcontainers.Kafka" Version="4.1.0" />
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.1.0" />
    <PackageVersion Include="Testcontainers.Azurite" Version="4.1.0" />
    <PackageVersion Include="Testcontainers.Elasticsearch" Version="4.1.0" />
    <PackageVersion Include="Testcontainers.LocalStack" Version="4.1.0" />
    <PackageVersion Include="Respawn" Version="6.2.1" />
    <PackageVersion Include="JustEat.HttpClientInterception" Version="5.1.1" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

