  <!-- Identity left for wow-two-sdk-beta.identity; these two stay as transitive pins (Microsoft.Data.SqlClient pulls
       them at 7.x), so CentralPackageTransitivePinningEnabled keeps them on the patched line. -->
  <ItemGroup Label="Identity model (transitive pins)">
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.14.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.14.0" />
  </ItemGroup>

