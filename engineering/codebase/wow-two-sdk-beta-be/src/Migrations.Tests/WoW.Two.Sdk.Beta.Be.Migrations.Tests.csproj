<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SQLITE DIALECT TESTS for the bespoke SQL migrator (beta-forever exception, like Mediator.Tests).

    Proves the engine on SQLite via temp-file databases — NO Testcontainers / Docker: apply, drift + repair,
    orphan, @no-transaction, single-applicant SQLite coordination, failure mid-batch, rollback, plus direct
    dialect checks. Postgres integration tests cover advisory locking, enum boundaries and interrupted indexes.
    Adds a NetArchTest web-freedom guard on the
    engine namespace. References the core mono-lib and matches its FrameworkReference so Microsoft.Extensions.*
    resolve from the shared framework rather than CPM-pinned packages.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Test-code conventions clash with latest-recommended-as-error: underscores in test names (CA1707),
         no ConfigureAwait (CA2007), public-method null guards (CA1062), static-test-class (CA1052). -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CA1707;CA2007;CA1062;CA1052;CA1819;xUnit1041</WarningsNotAsErrors>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Match the mono-lib's FrameworkReference so Microsoft.Extensions.* resolve from the shared framework. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="NetArchTest.Rules" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../WoW.Two.Sdk.Beta.Be.csproj" />
    <!-- Dogfood: the SDK's own migrator suite consumes the extracted Testing.Data harness (MigratorHarness, MigrationsWorkspace). -->
    <ProjectReference Include="../Testing.Data/WoW.Two.Sdk.Beta.Be.Testing.Data.csproj" />
    <ProjectReference Include="../Data/Migrations/cli/WoW.Two.Sdk.Beta.Be.Data.Migrations.Cli.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="TestData/Embedded/Migrations/002-missing/Apply.sql">
      <LogicalName>Migrations/002-missing/Apply.sql</LogicalName>
    </EmbeddedResource>
    <!-- A module-style set embedded under its own prefix, read by the CLI from this assembly. -->
    <EmbeddedResource Include="TestData/SetMigrations/identity/**/*.sql">
      <LogicalName>SetMigrations/identity/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- DbUp scripts the strategy-set tests run through the migrate tree; DbUp names a script by its resource name. -->
    <EmbeddedResource Include="TestData/DbUp/*.sql">
      <LogicalName>DbUpScripts.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
